{
  "name": "ts-php-debug-mcp",
  "version": "0.1.0",
  "description": "TypeScript MCP server for PHP/Xdebug debugging via vscode-php-debug DAP adapter",
  "type": "module",
  "main": "dist/index.js",
  "exports": {
    ".": "./dist/index.js",
    "./debug-backend.js": "./dist/debug-backend.js",
    "./dap-client.js": "./dist/dap-client.js",
    "./session.js": "./dist/session.js",
    "./config.js": "./dist/config.js",
    "./adapter-path.js": "./dist/adapter-path.js",
    "./adapter/*": "./dist/adapter/*",
    "./path-mapper.js": "./dist/path-mapper.js",
    "./notifications.js": "./dist/notifications.js",
    "./breakpoint-ledger.js": "./dist/breakpoint-ledger.js",
    "./breakpoint-verification.js": "./dist/breakpoint-verification.js",
    "./tools/index.js": "./dist/tools/index.js",
    "./tools/debug-stack-trace.js": "./dist/tools/debug-stack-trace.js",
    "./tools/debug-variables.js": "./dist/tools/debug-variables.js",
    "./tools/debug-scopes.js": "./dist/tools/debug-scopes.js",
    "./tools/debug-evaluate.js": "./dist/tools/debug-evaluate.js",
    "./tools/debug-threads.js": "./dist/tools/debug-threads.js",
    "./tools/debug-continue.js": "./dist/tools/debug-continue.js",
    "./tools/debug-next.js": "./dist/tools/debug-next.js",
    "./tools/debug-step-in.js": "./dist/tools/debug-step-in.js",
    "./tools/debug-step-out.js": "./dist/tools/debug-step-out.js",
    "./tools/debug-pause.js": "./dist/tools/debug-pause.js",
    "./tools/debug-set-breakpoints.js": "./dist/tools/debug-set-breakpoints.js",
    "./tools/debug-set-exception-breakpoints.js": "./dist/tools/debug-set-exception-breakpoints.js",
    "./tools/debug-exception-info.js": "./dist/tools/debug-exception-info.js",
    "./tools/debug-status.js": "./dist/tools/debug-status.js",
    "./tools/types.js": "./dist/tools/types.js",
    "./tools/errors.js": "./dist/tools/errors.js",
    "./tools/debug-launch.js": "./dist/tools/debug-launch.js",
    "./tools/debug-terminate.js": "./dist/tools/debug-terminate.js",
    "./tools/debug-wait.js": "./dist/tools/debug-wait.js",
    "./tools/schemas.js": "./dist/tools/schemas.js",
    "./tools/descriptions.js": "./dist/tools/descriptions.js",
    "./tools/references.js": "./dist/tools/references.js",
    "./tools/continuation.js": "./dist/tools/continuation.js",
    "./tools/thread-resolution.js": "./dist/tools/thread-resolution.js",
    "./tools/registry.js": "./dist/tools/registry.js",
    "./tools/debug-snapshot.js": "./dist/tools/debug-snapshot.js",
    "./tools/debug-plan-validate.js": "./dist/tools/debug-plan-validate.js",
    "./tools/debug-plan-run.js": "./dist/tools/debug-plan-run.js",
    "./tools/debug-plan-report.js": "./dist/tools/debug-plan-report.js",
    "./plan/*": "./dist/plan/*",
    "./prompts/*": "./dist/prompts/*",
    "./schemas/*": "./schemas/*"
  },
  "scripts": {
    "build": "tsc && node scripts/build-adapter.mjs",
    "build:adapter": "node scripts/build-adapter.mjs",
    "test": "vitest --run",
    "test:watch": "vitest",
    "check-schemas": "tsx scripts/check-schemas.ts",
    "sync-schemas": "tsx scripts/sync-schemas.ts",
    "emit-plan-schema": "tsx scripts/emit-plan-schema.ts",
    "check-plan-schema": "tsx scripts/emit-plan-schema.ts --check",
    "test:e2e": "vitest --run --config vitest.e2e.config.ts"
  },
  "license": "MIT",
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.26.0",
    "@vscode/debugprotocol": "^1.68.0",
    "zod": "^4.3.6"
  },
  "devDependencies": {
    "@types/node": "^25.2.3",
    "esbuild": "^0.27.7",
    "fast-check": "^4.5.3",
    "php-debug": "github:xdebug/vscode-php-debug#270fb6cfdffb7796cc6c033e1a21fbba3b56dbfa",
    "tsx": "^4.21.0",
    "typescript": "^5.9.3",
    "vitest": "^4.0.18"
  },
  "bin": {
    "php-debug-plan": "dist/plan/cli.js"
  }
}
